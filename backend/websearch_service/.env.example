# Backend environment variables — copy to .env and fill in real values.
# NEVER commit real secrets. Production startup validates the REQUIRED
# section (app/config.py + app/services/auth.py) and refuses to boot with
# missing or placeholder values (#210).

# ── REQUIRED in production ───────────────────────────────────────────────────

# Supabase project (Dashboard → Settings → API)
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT secret for verifying symmetric Supabase JWTs locally
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# OpenAI API key for AI chat functionality
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Deployment environment: development | test | production
ENVIRONMENT=development

# Exact browser origins allowed for CORS AND WebSocket handshakes (#205).
# Comma-separated, no wildcard. REQUIRED in production.
CORS_ORIGINS=https://your-frontend-domain.example

# Hostnames this API may be served as (Host-header allowlist).
# Comma-separated bare hostnames, no wildcard. REQUIRED in production.
TRUSTED_HOSTS=your-backend-domain.example

# ── Optional / feature-gated ─────────────────────────────────────────────────

# Tavily API key for web search (search endpoints degrade without it)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Perplexity API key (fallback when OpenAI hits rate limits)
# PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Redis for shared rate limiting AND single-use WebSocket tickets (#205).
# Strongly recommended in production with >1 worker/replica; without it both
# fall back to process-local state.
# REDIS_URL=redis://user:pass@host:6379/0
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_REDIS_KEY_PREFIX=websearch:rate_limit

# Single-use WebSocket ticket TTL in seconds (5–300, default 60)
# WS_TICKET_TTL_SECONDS=60

# Sentry error monitoring (backend) — release is tagged from APP_VERSION
# SENTRY_DSN=

# Uvicorn runtime (Dockerfile CMD): listen port, worker count, log level
# PORT=8000
# WORKERS=1
# LOG_LEVEL=info

# Release/version identifier surfaced in / and telemetry (set to the git SHA
# or image tag by the deploy pipeline)
# APP_VERSION=0.1.0

# Scheduler topology: exactly one replica may run the schedulers
# SCHEDULER_ENABLED=false

# Auth bypass for LOCAL DEV ONLY — production refuses to start when false
# AUTH_REQUIRED=true

# Readiness probe budget in seconds
# READINESS_TIMEOUT_SECONDS=3

# Optional model overrides (cost/accuracy tuning)
# If OPENAI_MODEL is set, it is used as a single override for all endpoints.
# OPENAI_MODEL=
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_CLASSIFIER_MODEL=gpt-5-nano
# OPENAI_TITLE_MODEL=gpt-4o-mini
# OPENAI_QUANT_MODEL=gpt-5-mini
# OPENAI_MAX_TOKENS=8000

# TheEyeBetaDataAPI (market data provider) — market endpoints return explicit
# unavailable states without it
# DATA_API_BASE_URL=
# SERVICE_CLIENT_ID=
# SERVICE_CLIENT_SECRET=
# SERVICE_REQUESTED_SCOPES=
