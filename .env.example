# Frontend environment variables (copy to .env for local development)
# NEVER commit real secrets to version control.

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API
VITE_PYTHON_API_URL=http://localhost:7000
VITE_WEBSEARCH_API_URL=http://localhost:7000

# Google OAuth — enable only on Vercel Production
VITE_GOOGLE_AUTH_ENABLED=false

# Support contact shown on landing page and legal pages
VITE_SUPPORT_EMAIL=theeyebeta@gmail.com

# Optional: monitor local backend health in dev
# VITE_ENABLE_LOCAL_BACKEND_MONITOR=true

# Optional: PostHog analytics
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
