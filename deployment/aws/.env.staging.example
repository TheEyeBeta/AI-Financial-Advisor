# Copy to .env.staging on the EC2 box (alongside docker-compose.aws.yml).
# NEVER commit the real file. Uses your existing staging Supabase project.

ENVIRONMENT=staging
BACKEND_PORT=8002
VALKEY_PORT=6380

# Existing staging Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

OPENAI_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

CORS_ORIGINS=https://your-staging-frontend.vercel.app
TRUSTED_HOSTS=staging-api.yourdomain.com

AUDIT_PSEUDONYM_PEPPER=
SENTRY_DSN=

WORKERS=1
APP_VERSION=
GIT_SHA=
