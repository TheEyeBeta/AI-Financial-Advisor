# Copy to .env.production on the EC2 box (alongside docker-compose.aws.yml).
# NEVER commit the real file. Values come from your existing prod Supabase
# project and Railway env vars — this only changes where the container runs.

ENVIRONMENT=production
BACKEND_PORT=8001
VALKEY_PORT=6379

# Existing prod Supabase project (Dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

OPENAI_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Public domains — must match nginx/prod.conf server_name and match what
# the Vercel prod frontend calls.
CORS_ORIGINS=https://your-prod-frontend.vercel.app
TRUSTED_HOSTS=api.yourdomain.com

AUDIT_PSEUDONYM_PEPPER=
SENTRY_DSN=

WORKERS=2
APP_VERSION=
GIT_SHA=
